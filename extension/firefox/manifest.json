{
  "manifest_version": 3,
  "name": "Paperful",
  "version": "0.1.0",
  "description": "Save the current page or selected tabs into your local Paperful mirror.",
  "browser_specific_settings": {
    "gecko": {
      "id": "addon@paperful.local",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png"
  },
  "action": {
    "default_title": "Save to Paperful",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "activeTab",
    "tabs",
    "downloads",
    "storage",
    "nativeMessaging",
    "scripting"
  ]
}
