; Marine Policy — Vale config for Paperful peer-review
; Copy to your project root as .vale.ini (or set [peer_review].vale_config).
;
;   cp styles/MarinePolicy/vale.ini.example .vale.ini
;   vale --config=.vale.ini path/to/manuscript.txt
;   uv run paperful peer-review --file manuscript.docx --vale
;
; Do not mix with JCP (citation styles conflict).

StylesPath = styles
MinAlertLevel = suggestion

[*]
BasedOnStyles = MarinePolicy
