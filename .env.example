# Copy to .env (gitignored). Compose reads this for variable substitution.
#
#   cp .env.example .env
# Host PAPERFUL_DATA is mounted at /data. out/ and state/ live inside it
# (/data/out, /data/state). Zotero Storage is not a Compose volume.

# Durable data directory mounted at /data (config.toml, packs/, out/, state/).
# Preferred (outside the git root):
PAPERFUL_DATA=../paperful-data
# Keep your current repo-local config/out/state without moving files:
# PAPERFUL_DATA=.

# Docker image pack (build arg). Rebuild after changing:
#   docker compose build --no-cache
# light — core + [serve] (Compose default when unset; CI uses this)
# heavy — also [llm] [rag] [browser-agent] for a full local env
PAPERFUL_IMAGE_MODE=heavy

# Host where Zotero's local API listens (Docker Desktop → host.docker.internal).
# On Linux with network_mode: host you can use localhost instead.
PAPERFUL_ZOTERO_HOST=host.docker.internal

# Host Ollama for Compose (same gateway). Outside Docker, Paperful falls back to
# 127.0.0.1 when this is host.docker.internal. Docker Desktop: default Ollama
# loopback is enough. Linux Engine: OLLAMA_HOST=0.0.0.0. See docs/llm.md#docker.
PAPERFUL_OLLAMA_HOST=host.docker.internal

# Free key from https://openalex.org/settings/api — never commit the real value.
# OPENALEX_API_KEY=

# Optional. Semantic Scholar works without a key. Request one for heavy use
# (it arrives by email): https://www.semanticscholar.org/product/api#api-key-form
# SEMANTIC_SCHOLAR_API_KEY=

# Optional. Google Scholar link discovery via SerpApi. Also set [serpapi].enabled
# and [serpapi].max_calls (default 20; 0 = unlimited). See docs/serpapi.md.
# SERPAPI_API_KEY=

# Optional. Self-hosted or cloud Twenty CRM. Also set [twenty].enabled and
# [twenty].base_url in config.toml. Used by twenty lookup and reachout --lookup.
# See docs/config.md.
# TWENTY_API_KEY=
# TWENTY_BASE_URL=
